# ==============================================================================
# TripNest — Frontend Production Environment (frontend/.env.production)
# ==============================================================================

# When using Nginx / Reverse Proxy in deployment, /api routes directly to backend.
# If hosted on a standalone CDN or separate API domain, set to: https://api.yourdomain.com/api
VITE_API_URL=/api

# Backend host base URL for OAuth triggers (empty when using reverse proxy routing)
VITE_BACKEND_URL=
