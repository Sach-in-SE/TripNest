# ==============================================================================
# TripNest — Local Development Environment Configuration (.env.example)
#
# Quickstart with Docker Desktop (PostgreSQL):
#   1. Copy this template: cp .env.example .env
#   2. Launch the local stack: docker compose -f docker-compose.dev.yml up -d
#   3. Access TripNest Web: http://localhost (or frontend dev: http://localhost:5173)
#   4. Backend API & Health: http://localhost:8080/actuator/health
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL Docker default)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tripnest_db
SPRING_DATASOURCE_USERNAME=tripnest_user
SPRING_DATASOURCE_PASSWORD=tripnest_password
POSTGRES_DB=tripnest_db
POSTGRES_USER=tripnest_user
POSTGRES_PASSWORD=tripnest_password

# ------------------------------------------------------------------------------
# Security & JWT Configuration (Min 32 chars)
# ------------------------------------------------------------------------------
JWT_SECRET=TripNestSecretKeyForLocalDevelopmentOnlyMin32Chars2026
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# File Storage Configuration
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
UPLOAD_DIR=uploads
TRIPNEST_UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------
PORT=8080
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# Seed Administrator Account (Created automatically on initial boot)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@tripnest.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecure2026!

# ------------------------------------------------------------------------------
# Optional: Google OAuth2 Single Sign-On (Leave empty for local email/password login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Optional: SMTP Email Service (Leave empty in local dev unless testing password resets)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@tripnest.com

# ------------------------------------------------------------------------------
# Optional: S3-Compatible Cloud Storage (Cloudflare R2 / AWS S3 / MinIO)
# ------------------------------------------------------------------------------
STORAGE_S3_BUCKET=tripnest-documents
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
