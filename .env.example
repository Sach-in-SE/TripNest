# ==============================================================================
# TripNest — Root Environment Variables Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# NEVER commit real production secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration (Required in Production)
# Dev Default: localhost:3306/tripnest_db, user: root, password: (empty)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/tripnest_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# Security & JWT Configuration (CRITICAL: Required in Production)
# Must be a 256-bit cryptographically secure secret string.
# ------------------------------------------------------------------------------
JWT_SECRET=your_256_bit_random_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Networking, Server Port & CORS
# ------------------------------------------------------------------------------
PORT=8080
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ------------------------------------------------------------------------------
# Google OAuth2 Authentication (Optional in Dev, Required for Google Login)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (Required for Password Resets)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
MAIL_FROM=noreply@tripnest.com

# ------------------------------------------------------------------------------
# Initial Administrator Account (Required in Production)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@tripnest.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# ------------------------------------------------------------------------------
# File Storage Configuration (local or s3)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
TRIPNEST_UPLOAD_DIR=uploads
STORAGE_S3_BUCKET=tripnest-documents
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
